# Copy to app/.env.local (gitignored) for local dev, and set the same names in Vercel → Project → Settings → Environment Variables.
# Everything prefixed VITE_ is compiled into the public page: use domain-restricted / free-tier keys only, never a private key.

# Extra RPC endpoints tried first (comma separated, https only). Alchemy / Chainstack / QuickNode / Dwellir / BlockVision URLs go here.
VITE_RPC_URLS=

# Alchemy: just the API key. The app builds the Monad mainnet/testnet endpoint itself and tries it first.
# In the Alchemy dashboard, restrict the key to your domain (Allowlist -> Domains).
VITE_ALCHEMY_KEY=
