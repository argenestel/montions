{
  "name": "@montions/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Montions: outcome-first binary options on Monad with a fully onchain order book.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "import": "./dist/abi/index.js"
    },
    "./deployments": {
      "types": "./dist/deployments-node.d.ts",
      "import": "./dist/deployments-node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen-abis": "node --import tsx scripts/gen-abis.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.0"
}
